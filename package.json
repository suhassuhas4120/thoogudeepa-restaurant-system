{
  "name": "thoogudeepa-restaurant-system",
  "version": "1.0.0",
  "description": "Thoogudeepa Donne Biryani Mane - Multi-Portal Restaurant Management System",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run type-check && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@tanstack/react-query": "^5.103.2",
    "autoprefixer": "^10.6.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "next": "^15.2.1",
    "next.js": "^1.0.3",
    "node.js": "^0.0.1-security",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.19",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^5.0.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "serve": "^14.2.6",
    "typescript": "^5.8.2",
    "vitest": "^5.0.2"
  }
}
